# ==============================================================================
# FinGuide Server Environment Configuration Example
# ==============================================================================

# Server Core
PORT=5000
NODE_ENV=development
SECRET_KEY=dev-secret-key-change-me-in-production-min-32-chars

# CORS Origin (Frontend URL in Production)
CORS_ORIGIN=https://fin-guide-gamma.vercel.app

# Database (Production: Turso Cloud libSQL; Development: Local SQLite fallback)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token
DATABASE_PATH=./data/finguide.db

# Python AI Agent Service
AGENT_SERVICE_URL=http://localhost:8000

# Email Delivery (Brevo HTTPS API for worldwide transactional OTPs)
BREVO_API_KEY=xkeysib-your-brevo-api-key
SMTP_USER=your-verified-email@gmail.com
